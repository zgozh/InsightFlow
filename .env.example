# 根目录 `.env` 示例。`make setup` 会保留已有值，并可把所选模型的 key 写入此文件。
# 真实凭据只写入被 Git 忽略的 `.env`；不要提交真实 key、密码或连接串。

# 模型服务凭据：只填写 `config.yaml` 中实际启用的模型所需变量。
# config.yaml 用 `api_key: $变量名` 引用对应值；也可通过 `make setup` 生成模型条目。
# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# OpenAI 与 OpenAI-compatible 网关
# OPENAI_API_KEY=your-openai-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# ORCAROUTER_API_KEY=your-orcarouter-api-key
# ATLASCLOUD_API_KEY=your-atlascloud-api-key
# 其他向导支持的模型服务
# VOLCENGINE_API_KEY=your-volcengine-api-key
# ZAI_API_KEY=your-zai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key
# MOONSHOT_API_KEY=your-moonshot-api-key
# NOVITA_API_KEY=your-novita-api-key
# MINIMAX_API_KEY=your-minimax-api-key

# Jina 网页正文提取：只有启用 web_fetch 且需要认证额度时才填写。
# JINA_API_KEY=your-jina-api-key

# 跨域部署：填写精确的浏览器来源，多个来源用逗号分隔。
# 默认通过同源 Nginx 访问时无需设置。
# GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Docker 入口设置；默认只绑定本机 127.0.0.1:2026。
# 只有在自有 TLS/认证入口或防火墙保护后，才考虑改为 0.0.0.0。
# BIND_HOST=127.0.0.1
# PORT=2026

# 日期上下文时区；默认使用运行进程的本地时区。
# DEER_FLOW_DATE_TIMEZONE=Asia/Shanghai

# 可选网络代理。Gateway 将这些变量传给需要访问外部服务的子进程。
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# LangSmith 追踪，默认关闭。启用后会把模型与工具调用元数据发送到所选服务。
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-langsmith-project

# Monocle 追踪为可选项；需要安装对应 extra。`okahu` exporter 还需要 OKAHU_API_KEY。
# MONOCLE_TRACING=true
# MONOCLE_EXPORTERS=file
# OKAHU_API_KEY=your-okahu-api-key

# Agent 在沙箱中使用 GitHub CLI 时的可选令牌。
# GITHUB_TOKEN=your-github-token

# Analytics 业务数据源凭据由管理员数据源页通过 `env://ANALYTICS_DS` 引用。
# 请把只读账号的 JSON 凭据保存在本机 `.env`；不要把密码写进 config.yaml 或提交到仓库。
# ANALYTICS_DS=<只读数据源凭据 JSON>

# 仅当 config.yaml 明确设置 database.backend: postgres 时需要应用数据库连接。
# 它与 Analytics 使用的外部业务数据库是两套连接。
# DATABASE_URL=postgresql://user:password@localhost:5432/insightflow

# 生产环境是否提供 Swagger UI、ReDoc 与 OpenAPI schema；默认开启。
# GATEWAY_ENABLE_DOCS=false

# `make up` 会自动生成 BETTER_AUTH_SECRET 和 DEER_FLOW_INTERNAL_AUTH_TOKEN。
# 仅在自行编排服务、或在服务外运行 Gateway worker 时才手动设置。
# BETTER_AUTH_SECRET=replace-with-a-random-secret
# DEER_FLOW_INTERNAL_AUTH_TOKEN=replace-with-a-random-token

# 外部 sandbox provisioner：服务需由运维单独部署；同一 key 还要配置在
# config.yaml 的 sandbox.provisioner_api_key 与 provisioner 服务端。
# PROVISIONER_API_KEY=your-provisioner-api-key

# 仅在启用 config.yaml 中的 OIDC Keycloak provider 时需要。
# KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# 前后端分开部署时覆盖 SSR 与可信来源；默认本机/统一 Nginx 部署无需设置。
# DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://localhost:8001
# DEER_FLOW_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:2026

# Docker 开发镜像构建的可选项；按需启用额外依赖或调整包索引。
# UV_EXTRAS=
# UV_INDEX_URL=https://pypi.org/simple
